APP_DOMAIN=docs.example.com
ACME_EMAIL=admin@example.com
POSTGRES_DB=docs_platform
POSTGRES_PASSWORD=change-this-postgres-password
SECRET_KEY=change-this-to-at-least-32-random-characters

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=change-this
SMTP_FROM=Docs Platform <noreply@example.com>

MEILISEARCH_API_KEY=change-this-meili-master-key
BILLING_ENABLED=false
IYZICO_API_KEY=change-this-iyzico-api-key
IYZICO_SECRET_KEY=change-this-iyzico-secret-key
IYZICO_MERCHANT_ID=change-this-iyzico-merchant-id
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_SUBSCRIPTION_PLAN_REF=change-this-iyzico-subscription-plan-reference-code
IYZICO_CALLBACK_BASE_URL=https://docs.example.com
SENTRY_DSN=https://public@example.ingest.sentry.io/project
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=docs-platform-1.0.0
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=180

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
REFRESH_TOKEN_EXPIRE_DAYS=30
PUBLIC_CACHE_ETAG_MAX_BYTES=262144
OPS_STATUS_DIR=/ops-status

PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_PASSWORD_HASH=replace-with-passlib-bcrypt-hash
PLATFORM_OWNER_TOTP_SECRET=replace-with-base32-secret

GRAFANA_ADMIN_PASSWORD=change-this
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/docs-platform-backups
RESTIC_PASSWORD=change-this-restic-password
AWS_ACCESS_KEY_ID=change-this-r2-key
AWS_SECRET_ACCESS_KEY=change-this-r2-secret
