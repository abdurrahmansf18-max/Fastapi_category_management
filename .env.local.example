# =============================================
# LOCAL DEVELOPMENT ENVIRONMENT — ÖRNEK
# Bu dosyayı .env.local olarak kopyalayın:
#   cp .env.local.example .env.local
# =============================================

# Ortam
ENVIRONMENT=development

# Domain (local)
APP_DOMAIN=localhost

# Database
POSTGRES_DB=docs_platform
POSTGRES_PASSWORD=change-this-local-password

# JWT Signing Key
SECRET_KEY=change-this-to-at-least-32-random-characters

# Search
MEILISEARCH_API_KEY=change-this-meili-key

# Platform Owner (local dev)
PLATFORM_OWNER_EMAIL=admin@localhost.dev
PLATFORM_OWNER_PASSWORD=change-this-admin-password
PLATFORM_OWNER_PASSWORD_HASH=
PLATFORM_OWNER_TOTP_SECRET=change-this-base32-totp-secret

# Email — MailHog (local'de SMTP trafiği MailHog'a gider, gerçek e-posta gitmez)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=false

# Cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_TOKEN_EXPIRE_DAYS=30
PUBLIC_CACHE_ETAG_MAX_BYTES=262144

# Ödeme sistemi — aktif etmek için uncomment edin
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_MERCHANT_ID=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# IYZICO_SUBSCRIPTION_PLAN_REF=
# IYZICO_CALLBACK_BASE_URL=http://localhost:3000

# Observability
LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=180
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=dev

# Grafana (observability profili)
GRAFANA_ADMIN_PASSWORD=admin

# Backup (ops profili — boş bırakılırsa backup çalışmaz)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=change-this
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
